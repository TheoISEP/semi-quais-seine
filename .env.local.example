# --- Site ---
NEXT_PUBLIC_SITE_URL=https://www.semiquaisdeseine.fr

# --- Base de données Neon (phase 1) ---
# Chaîne poolée (avec -pooler) pour l'app, chaîne directe pour les migrations Prisma.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
DIRECT_DATABASE_URL=postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# --- Admin / Better Auth (phase 1) ---
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# URL publique de l'app : http://localhost:3000 en local, https://www.semiquaisdeseine.fr en prod
BETTER_AUTH_URL=http://localhost:3000
# Segment d'URL secret de l'admin (8 à 64 caractères, lettres/chiffres/tirets) : /<ADMIN_SLUG>/
ADMIN_SLUG=gestion-sqs-k7x2m9

# --- Google Sheet (ancien système, à retirer après l'import) ---
# GOOGLE_SCRIPT_URL=

# --- Stripe (phase 2) ---
# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=

# --- AWS S3 + SES (phase 3) ---
# AWS_REGION=eu-west-3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_BUCKET=semi-quais-seine-assets
# S3_PUBLIC_BASE_URL=
# SES_FROM_EMAIL="Semi des Quais de Seine <inscriptions@semiquaisdeseine.fr>"
# SES_REPLY_TO=contact@semiquaisdeseine.fr
